# Copy to .env only if you want to override the local defaults.
HOST=127.0.0.1
PORT=5050
METAGUARD_DB_PATH=./security.db
METAGUARD_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
METAGUARD_CLOUD_FINDINGS_MODE=demo
METAGUARD_CLOUD_FINDINGS_PROVIDER=aws_security_hub
AWS_REGION=
# For local development only; never commit populated credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Alternatively use web identity (for example, EKS IRSA):
AWS_ROLE_ARN=
AWS_WEB_IDENTITY_TOKEN_FILE=

# Prowler runs from this isolated Windows virtual environment by default.
PROWLER_EXECUTABLE=.\.prowler-venv\Scripts\prowler.exe
PROWLER_SCAN_TIMEOUT_SECONDS=1800
METAGUARD_PROWLER_DATA_DIR=./.metaguard/prowler
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
